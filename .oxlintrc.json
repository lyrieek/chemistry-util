{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "jsPlugins": ["./scripts/oxlint-material-i18n.mjs"],
  "plugins": ["typescript", "unicorn", "oxc"],
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "pedantic": "error",
    "perf": "error",
    "style": "error",
    "restriction": "error",
    "nursery": "off"
  },
  "rules": {
    "material-i18n/length-check": "error",
    "no-explicit-any": "warn",
    "no-magic-numbers": "off",
    "id-length": "off",
    "curly": "off",
    "no-ternary": "off",
    "no-nested-ternary": "off",
    "no-array-for-each": "off",
    "no-non-null-assertion": "off",
    "no-plusplus": "off",
    "no-continue": "off",
    "no-console": "warn",
    "no-undefined": "warn",
    "no-zero-fractions": "off",
    "no-optional-chaining": "off",
    "no-shadow": "warn",
    "no-inline-comments": "off",
    "no-await-in-loop": "off",
    "require-unicode-regexp": "off",
    "prefer-named-capture-group": "off",
    "explicit-function-return-type": "off",
    "explicit-module-boundary-types": "off",
    "explicit-length-check": "off",
    "func-style": "off",
    "one-var": "off",
    "sort-imports": "off",
    "method-signature-style": "off",
    "sort-keys": "off",
    "explicit-member-accessibility": "off",
    "prefer-destructuring": "off",
    "capitalized-comments": "off",
    "complexity": ["warn", 30],
    "max-params": ["warn", 10],
    "max-statements": ["warn", 80],
    "max-lines-per-function": ["warn", 180],
    "max-lines": ["warn", 800],
    "require-await": "warn",
    "arrow-body-style": "off",
    "typescript/consistent-type-definitions": "off",
    "oxc/no-async-await": "off",
    "oxc/branches-sharing-code": "off",
    "unicorn/import-style": "off",
    "unicorn/numeric-separators-style": "off",
    "unicorn/prefer-ternary": "off",
    "unicorn/prefer-top-level-await": "off",
    "unicorn/no-null": "off",
    "unicorn/no-await-expression-member": "off",
    "unicorn/no-negated-condition": "warn",
    "unicorn/no-nested-ternary": "off",
    "unicorn/switch-case-braces": "off",
    "unicorn/catch-error-name": "off",
    "unicorn/filename-case": [
      "error",
      {
        "cases": {
          "pascalCase": true,
          "kebabCase": true
        }
      }
    ],
    "unicorn/prefer-query-selector": "off",
    "no-warning-comments": "warn",
    "new-cap": "off"
  },
  "env": {
    "builtin": true
  },
  "ignorePatterns": ["node_modules", "dist", "*.html", "*.bak*", "scripts/inline-build.mjs"]
}
